+    }
+
+    @Test func hashInsideAWordIsNotAHeading() {
+        let html = MarkdownHTML.render("C# (language)")
+        #expect(!html.contains("<h1>"))
+        #expect(html.contains("<p>C# (language)</p>"))
+    }
+
+    @Test func emphasis() {
