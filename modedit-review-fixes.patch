diff --git a/Sources/ModEditCore/Preview/HTMLEscaping.swift b/Sources/ModEditCore/Preview/HTMLEscaping.swift
new file mode 100644
index 0000000..4ff2693
--- /dev/null
+++ b/Sources/ModEditCore/Preview/HTMLEscaping.swift
@@ -0,0 +1,57 @@
+import Foundation
+
+/// Escaping for text that is inserted into HTML.
+enum HTMLEscaping {
+    /// Escapes `& < > " '` so `text` is inert in element content *and* in
+    /// quoted attribute values.
+    static func escape(_ text: String) -> String {
+        var out = ""
+        out.reserveCapacity(text.count)
+        for character in text {
+            switch character {
+            case "&":  out += "&amp;"
+            case "<":  out += "&lt;"
+            case ">":  out += "&gt;"
+            case "\"": out += "&quot;"
+            case "'":  out += "&#39;"
+            default:   out.append(character)
+            }
+        }
+        return out
+    }
+}
+
+/// The HTML page that wraps rendered preview bodies.
+enum PreviewPage {
+    /// Wraps `body` in a complete document with shared styling.
+    ///
+    /// The Content-Security-Policy forbids scripts, remote loads and frames, so
+    /// even if an escaping bug let markup through it could not execute code.
+    /// `color-scheme` makes the preview follow light/dark mode.
+    static func wrap(body: String) -> String {
+        """
+        <!DOCTYPE html>
+        <html>
+        <head>
+        <meta charset="utf-8">
+        <meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'; img-src data:">
+        <style>
+        :root { color-scheme: light dark; }
+        body { font-family: -apple-system, sans-serif; line-height: 1.5; padding: 20px; }
+        h1, h2, h3, h4, h5, h6 { line-height: 1.25; }
+        code, pre { font-family: ui-monospace, Menlo, monospace; font-size: 0.9em; }
+        code { background: rgba(127,127,127,0.15); padding: 1px 5px; border-radius: 3px; }
+        pre { background: rgba(127,127,127,0.12); padding: 12px; border-radius: 6px; overflow-x: auto; }
+        pre code { background: none; padding: 0; }
+        blockquote { margin-left: 0; padding-left: 12px; border-left: 3px solid rgba(127,127,127,0.5); color: gray; }
+        .math { font-family: "STIX Two Math", "Times New Roman", serif; font-style: italic; }
+        .math.display { display: block; text-align: center; margin: 1em 0; }
+        </style>
+        </head>
+        <body>
+        \(body)
+        </body>
+        </html>
+        """
+    }
+}
diff --git a/Sources/ModEditCore/Preview/LaTeXHTML.swift b/Sources/ModEditCore/Preview/LaTeXHTML.swift
new file mode 100644
index 0000000..7a97885
--- /dev/null
+++ b/Sources/ModEditCore/Preview/LaTeXHTML.swift
@@ -0,0 +1,92 @@
+import Foundation
+
+/// A lightweight LaTeX preview: it *renders* common constructs differently from
+/// the ASCII source (the editor's headline feature) without being a TeX engine.
+///
+/// Supported: `\section`/`\subsection`/`\subsubsection`, `\textbf`, `\emph`,
+/// `\textit`, `\texttt`, `\\`, `--`/`---`, `~`, `%` comments, inline `$...$`
+/// and display `$$...$$` math with Greek letters and common operators
+/// (see `symbols`), and `^`/`_` super- and subscripts.
+///
+/// Not supported: environments, `\frac`, `\sqrt`, macros, packages, citations.
+/// For typeset-quality maths, bundle KaTeX (see the README roadmap).
+///
+/// Everything is HTML-escaped first, so source such as `a < b` or `<script>`
+/// is displayed, never interpreted.
+enum LaTeXHTML {
+
+    /// `\name` -> symbol.
+    static let symbols: [String: String] = [
+        "alpha": "α", "beta": "β", "gamma": "γ", "delta": "δ", "epsilon": "ε",
+        "varepsilon": "ε", "theta": "θ", "lambda": "λ", "mu": "μ", "pi": "π",
+        "rho": "ρ", "sigma": "σ", "tau": "τ", "phi": "φ", "omega": "ω",
+        "Gamma": "Γ", "Delta": "Δ", "Theta": "Θ", "Lambda": "Λ", "Pi": "Π",
+        "Sigma": "Σ", "Phi": "Φ", "Omega": "Ω",
+        "times": "×", "cdot": "·", "pm": "±", "infty": "∞", "sum": "∑",
+        "prod": "∏", "int": "∫", "partial": "∂", "nabla": "∇",
+        "leq": "≤", "geq": "≥", "neq": "≠", "approx": "≈", "equiv": "≡",
+        "to": "→", "rightarrow": "→", "leftarrow": "←", "Rightarrow": "⇒",
+        "Leftarrow": "⇐", "in": "∈", "subset": "⊂", "forall": "∀", "exists": "∃",
+        "ldots": "…", "dots": "…",
+    ]
+
+    private static let blockBreak = "\u{E001}"
+
+    static func render(_ source: String) -> String {
+        var text = source
+
+        // With a preamble, preview only the document body.
+        if let begin = text.range(of: "\\begin{document}") {
+            text = String(text[begin.upperBound...])
+            if let end = text.range(of: "\\end{document}") {
+                text = String(text[..<end.lowerBound])
+            }
+        }
+
+        // Strip comments (an unescaped % to end of line), then escape.
+        text = text.replacingOccurrences(of: #"(?m)(?<!\\)%.*$"#, with: "", options: .regularExpression)
+        text = HTMLEscaping.escape(text)
+
+        // Sectioning commands become headings set apart by blank lines.
+        text = text.replacingMatches(
+            of: #"(?m)^[ \t]*\\(section|subsection|subsubsection)\*?\{([^}\n]*)\}"#
+        ) { groups in
+            let level = groups[1] == "section" ? 2 : (groups[1] == "subsection" ? 3 : 4)
+            return "\n\n<h\(level)>\(inline(groups[2]))</h\(level)>\n\n"
+        }
+
+        let blocks = text
+            .replacingOccurrences(of: #"\n\s*\n"#, with: blockBreak, options: .regularExpression)
+            .components(separatedBy: blockBreak)
+            .map { $0.trimmingCharacters(in: .whitespacesAndNewlines) }
+            .filter { !$0.isEmpty }
+
+        return blocks
+            .map { $0.hasPrefix("<h") ? $0 : "<p>\(inline($0))</p>" }   // escaped text never starts with "<"
+            .joined(separator: "\n")
+    }
+
+    /// Inline constructs. Input is already HTML-escaped.
+    private static func inline(_ text: String) -> String {
+        var s = text
+        s = s.replacingMatches(of: #"(?s)\$\$(.+?)\$\$"#) { "<span class=\"math display\">\(math($0[1]))</span>" }
+        s = s.replacingMatches(of: #"\$([^$\n]+)\$"#) { "<span class=\"math\">\(math($0[1]))</span>" }
+        s = s.replacingMatches(of: #"\\textbf\{([^{}]*)\}"#) { "<strong>\($0[1])</strong>" }
+        s = s.replacingMatches(of: #"\\(?:emph|textit)\{([^{}]*)\}"#) { "<em>\($0[1])</em>" }
+        s = s.replacingMatches(of: #"\\texttt\{([^{}]*)\}"#) { "<code>\($0[1])</code>" }
+        s = s.replacingOccurrences(of: #"\\\\"#, with: "<br>", options: .regularExpression)
+        s = s.replacingMatches(of: #"\\([A-Za-z]+)"#) { symbols[$0[1]] ?? $0[0] }
+        s = s.replacingOccurrences(of: "---", with: "\u{2014}")
+        s = s.replacingOccurrences(of: "--", with: "\u{2013}")
+        return s.replacingOccurrences(of: "~", with: "\u{00A0}")
+    }
+
+    /// Math content: symbols, then `^{..}`/`^x` and `_{..}`/`_x` scripts.
+    private static func math(_ text: String) -> String {
+        var s = text
+        s = s.replacingMatches(of: #"\\([A-Za-z]+)"#) { symbols[$0[1]] ?? $0[0] }
+        s = s.replacingMatches(of: #"\^\{([^{}]*)\}|\^(\w)"#) { "<sup>\($0[1].isEmpty ? $0[2] : $0[1])</sup>" }
+        s = s.replacingMatches(of: #"_\{([^{}]*)\}|_(\w)"#) { "<sub>\($0[1].isEmpty ? $0[2] : $0[1])</sub>" }
+        return s
+    }
+}
diff --git a/Sources/ModEditCore/Preview/MarkdownHTML.swift b/Sources/ModEditCore/Preview/MarkdownHTML.swift
new file mode 100644
index 0000000..0158262
--- /dev/null
+++ b/Sources/ModEditCore/Preview/MarkdownHTML.swift
@@ -0,0 +1,152 @@
+import Foundation
+
+/// A small Markdown-to-HTML converter for the live preview.
+///
+/// Supported: ATX headings (`#`..`######`), paragraphs, fenced code blocks,
+/// block quotes, bullet and numbered lists (flat), and the inline forms
+/// `` `code` ``, `**bold**`, `*italic*` and `[text](http(s)/mailto URL)`.
+///
+/// Not supported (yet): nested lists, tables, images, setext headings, HTML
+/// pass-through, `_underscore_` emphasis. For full CommonMark/GFM, replace this
+/// with `swift-markdown` (see the README roadmap).
+///
+/// ## Safety
+///
+/// All text is HTML-escaped *before* any markup is introduced, link targets are
+/// restricted to `http`, `https` and `mailto`, and code content is never
+/// re-interpreted. Raw HTML in the source is shown as text, not executed.
+enum MarkdownHTML {
+
+    static func render(_ source: String) -> String {
+        // "\r\n" is a single Character in Swift, so normalise before splitting.
+        let normalized = source
+            .replacingOccurrences(of: "\r\n", with: "\n")
+            .replacingOccurrences(of: "\r", with: "\n")
+
+        var out: [String] = []
+        var paragraph: [String] = []
+        var listTag: String?
+        var inFence = false
+        var fence: [String] = []
+
+        func flushParagraph() {
+            guard !paragraph.isEmpty else { return }
+            out.append("<p>" + inline(paragraph.joined(separator: "\n")) + "</p>")
+            paragraph.removeAll()
+        }
+        func closeList() {
+            guard let tag = listTag else { return }
+            out.append("</\(tag)>")
+            listTag = nil
+        }
+        func flushFence() {
+            out.append("<pre><code>" + HTMLEscaping.escape(fence.joined(separator: "\n")) + "</code></pre>")
+            fence.removeAll()
+        }
+
+        for line in normalized.split(separator: "\n", omittingEmptySubsequences: false).map(String.init) {
+            if line.trimmingCharacters(in: .whitespaces).hasPrefix("```") {
+                if inFence {
+                    flushFence()
+                    inFence = false
+                } else {
+                    flushParagraph()
+                    closeList()
+                    inFence = true
+                }
+                continue
+            }
+            if inFence {
+                fence.append(line)
+                continue
+            }
+            if line.trimmingCharacters(in: .whitespaces).isEmpty {
+                flushParagraph()
+                closeList()
+                continue
+            }
+            if let level = headingLevel(line) {
+                flushParagraph()
+                closeList()
+                let title = String(line.dropFirst(level).drop(while: { $0 == " " }))
+                out.append("<h\(level)>\(inline(title))</h\(level)>")
+                continue
+            }
+            if line.hasPrefix(">") {
+                flushParagraph()
+                closeList()
+                let quoted = String(line.dropFirst().drop(while: { $0 == " " }))
+                out.append("<blockquote>\(inline(quoted))</blockquote>")
+                continue
+            }
+            if let item = listItem(line) {
+                flushParagraph()
+                if listTag != item.tag {
+                    closeList()
+                    out.append("<\(item.tag)>")
+                    listTag = item.tag
+                }
+                out.append("<li>\(inline(item.content))</li>")
+                continue
+            }
+            closeList()
+            paragraph.append(line)
+        }
+        if inFence { flushFence() }   // unterminated fence: still show the code
+        flushParagraph()
+        closeList()
+        return out.joined(separator: "\n")
+    }
+
+    // MARK: Blocks
+
+    /// `1...6` if `line` is an ATX heading (hashes followed by a space).
+    private static func headingLevel(_ line: String) -> Int? {
+        let hashes = line.prefix(while: { $0 == "#" }).count
+        guard (1...6).contains(hashes), line.dropFirst(hashes).first == " " else { return nil }
+        return hashes
+    }
+
+    private static func listItem(_ line: String) -> (tag: String, content: String)? {
+        for marker in ["- ", "* ", "+ "] where line.hasPrefix(marker) {
+            return ("ul", String(line.dropFirst(marker.count)))
+        }
+        let digits = line.prefix(while: { $0.isASCII && $0.isNumber })
+        if !digits.isEmpty, line.dropFirst(digits.count).hasPrefix(". ") {
+            return ("ol", String(line.dropFirst(digits.count + 2)))
+        }
+        return nil
+    }
+
+    // MARK: Inline
+
+    /// Private-use character delimiting code-span placeholders.
+    private static let marker = "\u{E000}"
+
+    static func inline(_ text: String) -> String {
+        var s = HTMLEscaping.escape(text)
+
+        // Code spans first, parked behind placeholders so that emphasis and
+        // link syntax inside them is left alone.
+        var codeSpans: [String] = []
+        s = s.replacingMatches(of: #"`([^`\n]+)`"#) { groups in
+            codeSpans.append("<code>\(groups[1])</code>")
+            return "\(marker)\(codeSpans.count - 1)\(marker)"
+        }
+
+        s = s.replacingMatches(of: #"\[([^\]\n]+)\]\(([^)\s]+)\)"#) { groups in
+            let scheme = groups[2].lowercased()
+            guard scheme.hasPrefix("http://") || scheme.hasPrefix("https://") || scheme.hasPrefix("mailto:")
+            else { return groups[0] }   // e.g. javascript: stays inert text
+            // The URL was already escaped above, so it is safe inside quotes.
+            return "<a href=\"\(groups[2])\">\(groups[1])</a>"
+        }
+        s = s.replacingMatches(of: #"(?s)\*\*(?=\S)(.+?)(?<=\S)\*\*"#) { "<strong>\($0[1])</strong>" }
+        s = s.replacingMatches(of: #"\*(?=[^\s*])([^*\n]+?)(?<=[^\s*])\*"#) { "<em>\($0[1])</em>" }
+
+        return s.replacingMatches(of: "\(marker)(\\d+)\(marker)") { groups in
+            guard let index = Int(groups[1]), codeSpans.indices.contains(index) else { return "" }
+            return codeSpans[index]
+        }
+    }
+}
